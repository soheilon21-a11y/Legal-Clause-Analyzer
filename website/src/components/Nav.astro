---
import Logo from './Logo.astro';
import LangToggle from './LangToggle.astro';

const { t, lang, path = '' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const home = lang === 'de' ? base + 'de/' : base;
const repo = 'https://github.com/soheilon21-a11y/Legal-Clause-Analyzer';
const links = ['how', 'features', 'architecture', 'privacy', 'limitations', 'about', 'contact'];
---

<header class="site-header">
  <div class="container nav-inner">
    <Logo href={home} />
    <nav class="site-nav" aria-label={t.nav.aria}>
      {links.map((id) => <a class="nav-link" href={home + '#' + id}>{t.nav[id]}</a>)}
    </nav>
    <div class="nav-right">
      <a class="icon-link" href={repo} aria-label={t.nav.githubAria} rel="noopener">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
      </a>
      <LangToggle t={t} lang={lang} path={path} />
    </div>
    <details class="mobile-nav">
      <summary>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 4.5h14M2 9h14M2 13.5h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
        {t.nav.menu}
      </summary>
      <div class="menu-panel">
        {links.map((id) => <a href={home + '#' + id}>{t.nav[id]}</a>)}
        <a href={repo} rel="noopener">{t.nav.githubAria}</a>
      </div>
    </details>
  </div>
</header>
