---
const { href } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class="logo" href={href}>
  <svg class="logo-mark" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
    <rect x="1.5" y="1.5" width="21" height="21" rx="6" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
    <rect x="6" y="7" width="7.2" height="2.2" rx="1.1" fill="currentColor" opacity="0.55"></rect>
    <rect x="6" y="10.9" width="12" height="2.6" rx="1.3" fill="currentColor"></rect>
    <rect x="6" y="15" width="7.2" height="2.2" rx="1.1" fill="currentColor" opacity="0.55"></rect>
  </svg>
  <span class="logo-word">Namag</span>
</Tag>
